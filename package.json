{
  "name": "simulador-banco-central",
  "productName": "Simulador do Banco Central",
  "version": "3.2.0",
  "description": "Jogo de política monetária (Brasil e clássico) como app de desktop, sem internet.",
  "main": "app/main.js",
  "private": true,
  "scripts": {
    "app": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "br.simulador.bancocentral",
    "productName": "Simulador do Banco Central",
    "directories": { "output": "dist" },
    "files": ["app/**", "index.html", "lang.js", "platform.js", "config.js", "dsge.js", "dsge-models.js", "research.js", "chaos.js", "chaos-ui.js", "frbus.js", "frbus-model.js", "frbus-data.js", "frbus-ui.js", "package.json"],
    "win": { "target": "portable", "signAndEditExecutable": false },
    "portable": { "artifactName": "Simulador-do-Banco-Central-${version}.exe" }
  }
}
